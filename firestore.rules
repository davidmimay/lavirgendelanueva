rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function candlePath(candleId) {
      return /databases/$(database)/documents/candles/$(candleId);
    }

    function prayerPath(candleId, userId) {
      return /databases/$(database)/documents/candles/$(candleId)/prayers/$(userId);
    }

    function proposalVotePath(proposalId, userId) {
      return /databases/$(database)/documents/proposals/$(proposalId)/votes/$(userId);
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function canManageProposals() {
      return request.auth != null
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role
          in ['admin', 'administrator', 'administrador', 'president', 'presidente'];
    }

    function isMuseumAdmin() {
      return request.auth != null
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role is string
        && get(userPath(request.auth.uid)).data.role.lower()
          in ['admin', 'administrator', 'administrador'];
    }

    function validProposalVoteUpdate(proposalId, optionId) {
      let proposal = get(/databases/$(database)/documents/proposals/$(proposalId)).data;
      let updatedProposal = getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data;
      return request.auth != null
        && optionId is string
        && exists(/databases/$(database)/documents/proposals/$(proposalId))
        && !exists(proposalVotePath(proposalId, request.auth.uid))
        && existsAfter(proposalVotePath(proposalId, request.auth.uid))
        && updatedProposal.diff(proposal).affectedKeys().hasOnly(['options'])
        && proposal.options is map
        && updatedProposal.options is map
        && proposal.options.keys().hasAll(updatedProposal.options.keys())
        && updatedProposal.options.diff(proposal.options).affectedKeys().hasOnly([optionId])
        && proposal.options[optionId].label == updatedProposal.options[optionId].label
        && proposal.options[optionId].diff(updatedProposal.options[optionId]).affectedKeys().hasOnly(['votes'])
        && proposal.options[optionId].votes is int
        && updatedProposal.options[optionId].votes == proposal.options[optionId].votes + 1
        && getAfter(proposalVotePath(proposalId, request.auth.uid)).data.optionId == optionId;
    }

    match /candles/{candleId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'uid',
          'author',
          'intention',
          'message',
          'created',
          'prayersCount'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'author',
          'intention',
          'message',
          'created',
          'prayersCount'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 40
        && request.resource.data.intention in ['Pedir', 'Ofrecer', 'Agradecer', 'Bendecir']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 280
        && request.resource.data.created == request.time
        && request.resource.data.prayersCount == 1
        && existsAfter(prayerPath(candleId, request.auth.uid))
        && getAfter(prayerPath(candleId, request.auth.uid)).data.created == request.time;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayersCount'])
        && request.resource.data.prayersCount == resource.data.prayersCount + 1
        && !exists(prayerPath(candleId, request.auth.uid))
        && existsAfter(prayerPath(candleId, request.auth.uid))
        && getAfter(prayerPath(candleId, request.auth.uid)).data.created == request.time;
      allow delete: if false;

      match /prayers/{userId} {
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if false;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['created'])
          && request.resource.data.keys().hasOnly(['created'])
          && request.resource.data.created == request.time
          && existsAfter(candlePath(candleId))
          && (
            (!exists(candlePath(candleId))
              && getAfter(candlePath(candleId)).data.prayersCount == 1)
            || (exists(candlePath(candleId))
              && getAfter(candlePath(candleId)).data.prayersCount == get(candlePath(candleId)).data.prayersCount + 1)
          );
        allow update, delete: if false;
      }
    }

    match /prayers/{prayerId} {
      allow read: if true;
      allow create: if isMuseumAdmin()
        && request.resource.data.keys().hasAll([
          'title',
          'content',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'title',
          'content',
          'imageUrl',
          'imagePath',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 10000
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && (
          (!request.resource.data.keys().hasAny(['imageUrl', 'imagePath']))
          || (
            request.resource.data.keys().hasAll(['imageUrl', 'imagePath'])
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() > 0
            && request.resource.data.imageUrl.size() <= 2048
            && request.resource.data.imagePath == 'prayers/' + prayerId
          )
        );
      allow update, delete: if false;
    }

    match /bouquets/{bouquetId} {
      allow read: if true;
      allow write: if false;
    }

    match /museum/{pieceId} {
      allow read: if true;
      allow create: if isMuseumAdmin()
        && request.resource.data.category is string
        && exists(/databases/$(database)/documents/categories/$(request.resource.data.category))
        && request.resource.data.keys().hasAll([
          'title',
          'subtitle',
          'category',
          'year',
          'patron',
          'imageUrl',
          'imagePath',
          'description',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'title',
          'subtitle',
          'category',
          'year',
          'patron',
          'imageUrl',
          'imagePath',
          'description',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.subtitle is string
        && request.resource.data.subtitle.size() > 0
        && request.resource.data.subtitle.size() <= 160
        && request.resource.data.year is number
        && request.resource.data.patron is string
        && request.resource.data.patron.size() <= 120
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.imagePath is string
        && request.resource.data.imagePath == 'museum/' + pieceId
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1500
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /proposals/{proposalId} {
      allow read: if true;
      allow create: if canManageProposals()
        && request.resource.data.keys().hasAll([
          'title',
          'description',
          'closingDate',
          'options',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'title',
          'description',
          'closingDate',
          'options',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1000
        && request.resource.data.closingDate is string
        && request.resource.data.options is map
        && request.resource.data.options.keys().size() >= 2
        && request.resource.data.options.keys().size() <= 8
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if false;
      allow update: if validProposalVoteUpdate(
        proposalId,
        getAfter(proposalVotePath(proposalId, request.auth.uid)).data.optionId
      );

      match /votes/{userId} {
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if false;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['optionId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['optionId', 'createdAt'])
          && request.resource.data.optionId is string
          && request.resource.data.createdAt == request.time
          && validProposalVoteUpdate(proposalId, request.resource.data.optionId);
        allow update, delete: if false;
      }
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if canManageProposals()
        && request.resource.data.keys().hasAll([
          'title',
          'summary',
          'tag',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'title',
          'summary',
          'tag',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && request.resource.data.summary.size() <= 1000
        && request.resource.data.tag in ['Cabildo', 'Cultos', 'Obra Social', 'Aviso']
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
  }
}
